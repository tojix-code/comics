# Copy to .env for local development (never commit a real .env).
# The frontend talks to the manga-novel-api backend first and falls back to
# the public MangaDex API (https://api.mangadex.org) when the backend is down.
# Leave this empty in development: Vite proxies /api to localhost:3001.
VITE_API_URL=http://localhost:3001

# Default content source used for browsing: mangadex | comick
# (comick works only through the backend; mangadex also works direct.)
VITE_DEFAULT_SOURCE=mangadex

# Google Sign-In (optional — email sign-in works without it).
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console,
# add your site origin to "Authorized JavaScript origins", and paste the ID:
VITE_GOOGLE_CLIENT_ID=
